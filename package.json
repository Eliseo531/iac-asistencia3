{
  "name": "iac-asistencia-root",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema Web de Registro y Control de Asistencia",
  "scripts": {
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "seed": "npm --prefix backend run seed",
    "test:backend": "npm --prefix backend run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
